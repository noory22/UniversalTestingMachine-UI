     <property name="styleSheet">
      <string notr="true">QPushButton{
	background-color: qlineargradient(spread:pad, x1:0.47, y1:0, x2:0.5, y2:1, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(239, 239, 239, 255));
color:  #308DC2;
border:1px solid #bebebe;
text-align: left;
padding-left: 5px;
}

QPushButton:pressed{
background-color: #bebebe;
}
QPushButton {
    padding-left: 10px; /* Adds padding on the left of the text */
    padding-right: 10px; /* Adds padding on the right of the icon */
    text-align: left; /* Aligns text to the left for better spacing */
    icon-size: 16px 16px; /* Adjusts icon size if needed */
}

QPushButton::menu-indicator {
    subcontrol-origin: padding; /* Ensures proper spacing for dropdown icon */
    subcontrol-position: right center; /* Aligns dropdown icon to the right */
    padding-right: 10px; /* Adds space to the right of the dropdown icon */
}
</string>
