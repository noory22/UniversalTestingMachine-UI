{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UTM",
  "version": "1.0.2",
  "identifier": "com.revivemedical.utm",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../.vite/build/renderer/main_window"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Universal Testing Machine",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
